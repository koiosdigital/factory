{
  "name": "firmware-spa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,js,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,js,json,css}\"",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "generate:api": "pnpm exec openapi-typescript https://firmware.api.koiosdigital.net/swagger.json -o src/types/firmware-api.ts"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.1",
    "@nuxt/ui": "4.10.0",
    "@unhead/vue": "^3.2.3",
    "@xterm/xterm": "^6.0.0",
    "esptool-js": "^0.6.0",
    "oidc-client-ts": "^3.5.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.2",
    "spark-md5": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "packageManager": "pnpm@11.0.0-dev.1005+sha512.91f84a392eea348ea4852a182912d2520273a4336f933b78cc44bc931eb999923c097e9433a9b355adc1f725725ea99082fc9f032a559df832632e764c92c798",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/spark-md5": "^3.0.5",
    "@types/w3c-web-serial": "^1.0.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8",
    "wrangler": "^4.42.0"
  }
}
